{
  "name": "goatnote-disposition",
  "version": "1.0.0",
  "private": true,
  "description": "GOATnote Disposition: a synthetic-message bioengineering classroom demonstration.",
  "type": "module",
  "workspaces": [
    "apps/evaluation"
  ],
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "scripts": {
    "demo": "node scripts/demo.mjs",
    "demo:check": "node scripts/demo.mjs --check",
    "demo:offline": "node scripts/demo.mjs --offline",
    "dev": "npm run dev --workspace @goatnote-disposition/evaluation",
    "build": "npm run review:build",
    "review:build": "npm run build --workspace @goatnote-disposition/evaluation",
    "review:test": "npm run test --workspace @goatnote-disposition/evaluation",
    "lint": "node scripts/lint.mjs",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace @goatnote-disposition/evaluation",
    "test": "MASTRA_TELEMETRY_DISABLED=true node --experimental-strip-types --test tests/*.test.mjs && npm run review:test",
    "saved:build": "node scripts/build-classroom-review.mjs",
    "saved:verify": "node scripts/build-classroom-review.mjs --verify"
  },
  "dependencies": {
    "@mastra/core": "1.66.0",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@types/node": "26.5.1",
    "typescript": "7.0.2"
  }
}
